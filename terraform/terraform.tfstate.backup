            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::896159011121:oidc-provider/oidc.eks.eu-central-1.amazonaws.com/id/8CDEFB6D9F71D150FECE9B93AA1F94C8\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.eu-central-1.amazonaws.com/id/8CDEFB6D9F71D150FECE9B93AA1F94C8:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.eu-central-1.amazonaws.com/id/8CDEFB6D9F71D150FECE9B93AA1F94C8:sub\": \"system:serviceaccount:kube-system:ebs-csi-controller-sa\"\n        }\n      }\n    }\n  ]\n}",
